<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sr_background">

    <!-- Título tipo barra superior -->
    <TextView
        android:id="@+id/txtNewChatTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nuevo chat"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/sr_text_primary"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor principal (tarjeta) -->
    <LinearLayout
        android:id="@+id/panelNewChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel_card"
        app:layout_constraintTop_toBottomOf="@id/txtNewChatTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp">

        <!-- Indicaciones -->
        <TextView
            android:id="@+id/txtSelectUsersHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccioná uno o varios contactos para iniciar el chat."
            android:textColor="@color/sr_text_secondary"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- Listado de usuarios con selección múltiple -->
        <ListView
            android:id="@+id/listSelectableUsers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:choiceMode="multipleChoice"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:clipToPadding="true"
            android:scrollbars="none" />

        <!-- Nombre de grupo (solo tendrá efecto si eligen 2 o más) -->
        <TextView
            android:id="@+id/txtGroupNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del grupo (opcional)"
            android:textColor="@color/sr_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sr_text_primary"
            android:textColorHint="@color/sr_text_secondary"
            android:background="@drawable/bg_edittext_rounded"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="textCapWords" />

        <!-- Botón crear -->
        <Button
            android:id="@+id/btnCreateChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear chat"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chat_new_button" />

    </LinearLayout>

    <!-- Loader centrado -->
    <ProgressBar
        android:id="@+id/progressSelectableUsers"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
