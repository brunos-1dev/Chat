<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtNewChatTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo chat"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:paddingBottom="8dp" />

    <!-- Nombre del grupo (solo se usa si hay más de un invitado) -->
    <EditText
        android:id="@+id/edtGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del grupo (opcional)"
        android:inputType="textCapWords"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/progressSelectableUsers"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:padding="8dp" />

    <ListView
        android:id="@+id/listSelectableUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnCreateChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear chat"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>

